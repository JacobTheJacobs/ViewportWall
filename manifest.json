{
  "manifest_version": 3,
  "name": "Viewport Wall",
  "version": "1.1.2",
  "description": "See your site on every screen at once: phones, foldables, tablets, TVs. Synced scroll and clicks, plus an MCP server for AI agents.",
  "minimum_chrome_version": "116",
  "permissions": [
    "debugger",
    "tabs",
    "tabGroups",
    "storage",
    "activeTab",
    "scripting",
    "webNavigation"
  ],
  "action": {
    "default_title": "Open Viewport Wall"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "host_permissions": [
    "http://localhost/*",
    "https://localhost/*",
    "http://127.0.0.1/*",
    "https://127.0.0.1/*",
    "http://*.localhost/*"
  ]
}